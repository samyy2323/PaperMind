# Copy to .env for local (non-docker) runs.
DATABASE_URL=sqlite:///./papermind.db
# DATABASE_URL=postgresql+psycopg2://papermind:papermind@localhost:5432/papermind
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./storage
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173

# celery (needs Redis + `celery -A app.tasks.celery_app worker`) | thread (no Redis, dev only) | inline (tests)
PIPELINE_MODE=thread

LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

OCR_BACKEND=trocr
LINE_DETECTOR=doctr
# CORRECTION_MODEL_PATH=/models/byt5-ocr-correction   # unset => pass-through (TODO: fine-tune)
